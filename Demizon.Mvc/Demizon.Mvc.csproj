<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Demizon.Mvc</RootNamespace>
        <LangVersion>default</LangVersion>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>107a1f1d-2b6e-43e5-bab9-1c84faff249c</UserSecretsId>

        <!--
          Cílový hosting je Scaleway Stardust: 1 vCPU, 1 GB RAM. Web SDK zapíná
          Server GC defaultně, ten má velké gen0 budgety a nevrací paměť OS —
          proces vyroste na stovky MB, i když živých dat je zlomek.
          Workstation GC je pro jednojádrový stroj s málo pamětí správná volba.
        -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
        <Content Include="..\.gitignore">
            <Link>.gitignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Append.Blazor.Notifications" Version="1.1.0" />
        <PackageReference Include="CryptoHelper" Version="5.1.0" />
        <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="MudBlazor" Version="9.9.0" />
        <PackageReference Include="WebPush" Version="1.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Demizon.Contracts\Demizon.Contracts.csproj" />
        <ProjectReference Include="..\Demizon.Core\Demizon.Core.csproj" />
        <ProjectReference Include="..\Demizon.Dal\Demizon.Dal.csproj" />
        <ProjectReference Include="..\Demizon.Common\Demizon.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Pages\Admin\Member\Components\MemberForm.razor" />
      <_ContentIncludedByDefault Remove="Pages\Admin\Member\Detail.razor" />
      <_ContentIncludedByDefault Remove="Pages\Admin\Member\ListMembers.razor" />
    </ItemGroup>

    <PropertyGroup>
        <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <MudIllegalParameters>V7IgnoreCase</MudIllegalParameters>
        <MudAllowedAttributePattern>LowerCase</MudAllowedAttributePattern>
    </PropertyGroup>

    <ItemGroup>
        <Compile Update="Locales\DemizonLocales.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>DemizonLocales.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Locales\DemizonLocales.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>DemizonLocales.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Update="demizon.sqlite">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
