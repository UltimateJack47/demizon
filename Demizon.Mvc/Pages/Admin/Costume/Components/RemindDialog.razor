<MudDialog Style="min-width: min(440px, calc(100vw - 32px))">
    <TitleContent>
        <MudText Typo="Typo.h6">Připomenout vrácení (@Count @(Count == 1 ? "člen" : "členů"))</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Každý dostane push se seznamem kusů, které má u sebe. Text níž ho uvede; prázdný = obecná výzva.
        </MudText>
        <MudTextField @bind-Value="_message" Label="Zpráva (nepovinná)" Lines="3" MaxLength="500"
                      Variant="Variant.Outlined" Placeholder="Např. Do neděle prosím vraťte kroje po hodech."/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Zpět</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close(DialogResult.Ok(_message ?? string.Empty))">
            Odeslat
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int Count { get; set; }

    private string? _message;
}
