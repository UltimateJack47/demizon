@using Demizon.Core.Services.Costume

<MudDialog Style="min-width: min(440px, calc(100vw - 32px))">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsUpdate ? "Upravit kroj" : "Nový kroj")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_name" Label="Název" Required="true" RequiredError="Název je povinný."
                          MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudTextField @bind-Value="_description" Label="Popis" Lines="3" MaxLength="1000"
                          Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudNumericField @bind-Value="_sortOrder" Label="Pořadí v seznamu" Variant="Variant.Outlined"
                             Margin="Margin.Dense"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Zrušit</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClickedOk">@(IsUpdate ? "Uložit" : "Vytvořit")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool IsUpdate { get; set; }
    [Parameter] public CostumeInput? Initial { get; set; }

    private MudForm _form = null!;
    private string _name = "";
    private string? _description;
    private int _sortOrder;

    protected override void OnInitialized()
    {
        _name = Initial?.Name ?? "";
        _description = Initial?.Description;
        _sortOrder = Initial?.SortOrder ?? 0;
    }

    private async Task ClickedOk()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;
        MudDialog.Close(DialogResult.Ok(new CostumeInput(_name, _description, _sortOrder)));
    }
}
