<MudDialog Style="min-width: min(440px, calc(100vw - 32px))">
    <TitleContent>
        <MudText Typo="Typo.h6">Odmítnout převzetí</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Kusy zůstanou předávajícímu a správce krojárky dostane tvůj důvod.
            Popiš, co nesedí — třeba poškození, které na fotce není vidět.
        </MudText>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_reason" Label="Důvod" Lines="3" MaxLength="1000" Required="true"
                          RequiredError="Bez důvodu správce neví, co řešit." Variant="Variant.Outlined"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Zpět</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ClickedOk">Odmítnout</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private string _reason = "";

    private async Task ClickedOk()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;
        MudDialog.Close(DialogResult.Ok(_reason));
    }
}
