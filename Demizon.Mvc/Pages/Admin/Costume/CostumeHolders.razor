@page "/Admin/Costumes/Holders"
@using Demizon.Core.Services.Costume
@using Demizon.Dal.Entities
@using Demizon.Mvc.Services.Authentication

@attribute [Authorize(Roles = RoleNames.CostumeViewers)]
@layout AdminMainLayout

@inject ICostumeCatalogService Catalog
@inject ICostumeTransferService Transfers

<PageTitle>@PageService.GetTitle()</PageTitle>

<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="Admin/Costumes" title="Zpět do krojárky" Class="mb-2"/>

@if (_open.Count > 0)
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Otevřené předávky</b></MudText>
        @foreach (var transfer in _open)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1" Wrap="Wrap.Wrap">
                <MudChip T="string" Size="Size.Small" Color="@transfer.Status.Color()">@transfer.Status.Label()</MudChip>
                <MudLink Href="@($"Admin/Costumes/Transfers/{transfer.Id}")">
                    @CostumeUi.Party(transfer.FromMemberId, _names) → @CostumeUi.Party(transfer.ToMemberId, _names)
                    · @string.Join(", ", transfer.Lines.Select(l => l.Item.Code))
                </MudLink>
            </MudStack>
        }
    </MudPaper>
}

<MudPaper Class="pa-3" Elevation="1">
    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Kdo co má</b> (@_byMember.Count @(_byMember.Count == 1 ? "člen" : "členů"))</MudText>
    @if (_byMember.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Všechno je v krojárce.</MudText>
    }
    @foreach (var member in _byMember)
    {
        <MudText Class="mt-2"><b>@CostumeUi.Party(member.Key, _names)</b>
            <MudText Inline="true" Typo="Typo.caption" Color="Color.Secondary">
                · hodnota @member.Sum(h => (h.Item.ValueCzk ?? 0) * h.Quantity) Kč
            </MudText>
        </MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <tbody>
            @foreach (var holding in member)
            {
                <tr>
                    <td style="width: 90px;"><MudLink Href="@($"Admin/Costumes/Items/{holding.Item.Code}")">@holding.Item.Code</MudLink></td>
                    <td>@holding.Item.Describe()</td>
                    <td style="width: 60px;">@holding.Quantity ks</td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    private List<IGrouping<int, CostumeHolding>> _byMember = [];
    private IReadOnlyList<CostumeTransfer> _open = [];
    private IReadOnlyDictionary<int, CostumeMemberName> _names = new Dictionary<int, CostumeMemberName>();

    protected override async Task OnInitializedAsync()
    {
        PageService.SetTitle("Kdo co má");
        var holdings = await Catalog.GetHoldingsAsync();
        _open = await Transfers.GetOpenAsync();
        _names = await Catalog.GetMemberNamesAsync(holdings.Select(h => h.MemberId)
            .Concat(_open.SelectMany(t => new[] { t.FromMemberId, t.ToMemberId }).OfType<int>()));
        _byMember = holdings.GroupBy(h => h.MemberId)
            .OrderBy(g => _names.TryGetValue(g.Key, out var n) ? n.FullName : "")
            .ToList();
    }
}
