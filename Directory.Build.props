<Project>
  <!--
    SixLabors.ImageSharp stays pinned at [3.1.12]: from 3.2.0 the package validates a Six Labors
    licence key at build time. These advisories are fixed only in 3.2.0 / 4.1.2 and are accepted
    deliberately, because the app does not reach the vulnerable code (checked against the v3.1.12
    sources on 2026-10-26):
      - GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w: TIFF CCITT encoders; uploads are encoded to JPEG only.
      - GHSA-wmxv-xphr-5c9g: BigTIFF decoder hang; FileUploadService decodes JPEG/PNG/WebP/GIF only.
      - GHSA-j3p4-wp97-rph4: HistogramEqualization on float TIFF; neither is used.
      - GHSA-gwg2-r3hj-4w44: ICC CLUT parsing; decoders keep the ICC bytes and check only the header,
        the CLUT is parsed on IccProfile.Entries, which nothing reads.
    Revisit when upgrading ImageSharp. Details: docs/features/disk-optimalizace/README.md.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
  </ItemGroup>
</Project>
